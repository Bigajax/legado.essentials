# ---------------------------------------------------------------------------
# LEGADO essentials — copie para .env.local e preencha
# ---------------------------------------------------------------------------

# URL pública do site (sitemap, OG e o link da mensagem do WhatsApp).
# Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://legadoessentials.com.br

# WhatsApp que recebe os pedidos. Só dígitos: DDI + DDD + número.
# PENDENTE: o perfil do Instagram não publica telefone. Confirmar com o cliente.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Senha do painel em /admin. Defina uma: sem ela o código cai num padrão
# de desenvolvimento.
ADMIN_SENHA=

# Segredo que assina o cookie de sessão. Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SEGREDO=
